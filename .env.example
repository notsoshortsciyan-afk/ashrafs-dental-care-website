# Neon Postgres connection string (shared with the patient-management dashboard).
# Copy this file to `.env` and paste your real Neon string. NEVER commit `.env`.
#
# Get it from the Neon console → your project → "Connection string" (use the
# pooled connection string ending in "-pooler" for serverless).
#
# Example:
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL=""
